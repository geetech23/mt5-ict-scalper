# Copy to .env (gitignored) or run `python main.py` for the setup wizard.
BROKER=tradelocker            # tradelocker | mt5 | sim
SIMULATION_MODE=true          # true = no real orders (paper trading on built-in simulator)

# TradeLocker
TL_ENVIRONMENT=demo           # demo | live
TL_EMAIL=
TL_PASSWORD=
TL_SERVER=
TL_ACC_NUM=0

# MetaTrader 5 (optional)
MT5_LOGIN=0
MT5_PASSWORD=
MT5_SERVER=

# Trading
SYMBOLS=EURUSD,XAUUSD
TIMEFRAME=M5                  # M5 | M15
HTF_TIMEFRAME=M15
ENABLED_SESSIONS=LONDON,NY,ASIA
LONDON_START=8
LONDON_END=16
NY_START=13
NY_END=21
ASIA_START=22
ASIA_END=8
# Optional per-session symbols, e.g. SESSION_SYMBOLS_ASIA=USDJPY,AUDUSD
SESSION_SYMBOLS_LONDON=
SESSION_SYMBOLS_NY=
SESSION_SYMBOLS_ASIA=

# Risk
RISK_PER_TRADE_PCT=1.0
POSITION_SIZE_MULTIPLIER=1.0
MIN_RR=2.0
DAILY_LOSS_LIMIT_PCT=3.0
MAX_CONSECUTIVE_LOSSES=3
# Adaptive compounding / dynamic risk (defaults shown)
# ADAPTIVE_RISK_ENABLED=true
# DAILY_PROFIT_TARGET_PCT=15.0
# RISK_TIER1_GROWTH_PCT=5.0
# RISK_TIER1_PCT=1.25
# RISK_TIER2_GROWTH_PCT=10.0
# RISK_TIER2_PCT=1.5
# MAX_RISK_PER_TRADE_PCT=1.5
# REDUCED_RISK_PCT=0.5
# DRAWDOWN_PROTECTION_PCT=2.0
# MAX_AGGREGATE_RISK_PCT=3.0
# COOLDOWN_MINUTES=30
# RECOVERY_MINUTES=30
# RECOVERY_WINS=2
# PERF_WINDOW_TRADES=10
# PERF_MIN_TRADES=3
# PERF_MIN_WIN_RATE=0.5
MAX_TRADES_PER_SESSION=5
BREAKEVEN_R=1.0
TRAILING_R=1.5

# ICT thresholds
SWING_LOOKBACK=3
FVG_MIN_PIPS=1.0
OB_IMPULSE_ATR=1.5
EQUAL_LEVEL_TOLERANCE_PIPS=2.0
MIN_CONFLUENCE=2

# Dashboard
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
OPEN_BROWSER=true
